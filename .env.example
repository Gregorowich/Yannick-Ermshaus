# --- Jarvis Konfiguration ---
# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.

# Claude (das "Gehirn") – https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Spracherkennung Whisper + Stimme TTS) – https://platform.openai.com/
OPENAI_API_KEY=sk-...

# Picovoice (Weckwort "Jarvis" im Browser) – https://console.picovoice.ai/
# Kostenloses Kontingent. Wird an das Frontend weitergegeben.
PICOVOICE_ACCESS_KEY=...

# Optional: Port des Servers (Standard 3000)
PORT=3000
